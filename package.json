    "brace-expansion@2": "2.1.7",
    "undici@7": "7.30.2",
    "browserslist": "4.29.5",
    "prosemirror-view": "1.42.9",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-blockquote": "3.33.0",
    "@tiptap/extension-bold": "3.33.0",
    "@tiptap/extension-bubble-menu": "3.33.0",
    "@tiptap/extension-bullet-list": "3.33.0",
    "@tiptap/extension-code": "3.33.0",
    "@tiptap/extension-code-block": "3.33.0",
